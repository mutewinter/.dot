# Core shell / filesystem (aligned with Cursor command allowlist)
prefix_rule(pattern=["mkdir", "-p"], decision="allow")
prefix_rule(pattern=["cp"], decision="allow")
prefix_rule(pattern=["mv"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["file"], decision="allow")
prefix_rule(pattern=["readlink"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["true"], decision="allow")
prefix_rule(pattern=["sleep"], decision="allow")
prefix_rule(pattern=["echo"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["tr"], decision="allow")
prefix_rule(pattern=["date"], decision="allow")
prefix_rule(pattern=["pbcopy"], decision="allow")
prefix_rule(pattern=["man"], decision="allow")

# Search / parse
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["htmlq"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")

# Network / fetch
prefix_rule(pattern=["curl"], decision="allow")

# Git (read + safe restore; omit commit/push)
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "tag"], decision="allow")
prefix_rule(pattern=["git", "branch"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["git", "rev-list"], decision="allow")
prefix_rule(pattern=["git", "ls-remote"], decision="allow")
prefix_rule(pattern=["git", "submodule"], decision="allow")
prefix_rule(pattern=["git", "--version"], decision="allow")
prefix_rule(pattern=["git", "-C"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "pull"], decision="allow")
prefix_rule(pattern=["git", "restore"], decision="allow")

# pnpm / npm / TypeScript
prefix_rule(pattern=["pnpm", "add"], decision="allow")
prefix_rule(pattern=["pnpm", "list"], decision="allow")
prefix_rule(pattern=["pnpm", "test"], decision="allow")
prefix_rule(pattern=["pnpm", "exec"], decision="allow")
prefix_rule(pattern=["pnpm", "audit"], decision="allow")
prefix_rule(pattern=["pnpm", "outdated"], decision="allow")
prefix_rule(pattern=["pnpm", "exec", "chrome-devtools"], decision="allow")
prefix_rule(pattern=["npm", "test"], decision="allow")
prefix_rule(pattern=["npx", "tsgo"], decision="allow")

# Commit messages and heredoc helpers
prefix_rule(
    pattern=["printf"],
    decision="allow",
    justification="Commit messages and other printf output for git/heredoc workflows",
    match=[
        'printf "%s" "feat(studio): warn when x64 app runs under arm64 translation"',
        'printf "%s" "fix(web): serve svg images unoptimized"',
    ],
)

# Tooling
prefix_rule(pattern=["gh"], decision="allow")
prefix_rule(pattern=["iconutil"], decision="allow")
prefix_rule(pattern=["magick"], decision="allow")
prefix_rule(pattern=["gdu-go"], decision="allow")
