[user]
	name = Jeremy Mack
	email = mutewinter@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519.pub
[pull]
	rebase = true
[alias]
	up = pull --rebase --autostash
[commit]
	gpgsign = true
[gpg]
	format = ssh
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# Stores $HOME as ~ so committed files never name the machine's user, and
# restores it on checkout for tools like herdr that write absolute paths.
[filter "homedir"]
	clean = sed \"s|$HOME/|~/|g\"
	smudge = sed \"s|'~/|'$HOME/|g\"
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only --features=interactive
[delta]
	features = decorations
	# Diff tints from the Jellybeans palette in ghostty/config and hunk/config.toml
	minus-style = syntax "#260d10"
	minus-emph-style = syntax "#392121"
	plus-style = syntax "#0e1f0e"
	plus-emph-style = syntax "#162921"
[delta "interactive"]
	keep-plus-minus-markers = false
[delta "decorations"]
	commit-decoration-style = blue ol
	commit-style = raw
	file-style = omit
	hunk-header-decoration-style = blue box
	hunk-header-file-style = red
	hunk-header-line-number-style = "#067a00"
	hunk-header-style = file line-number syntax
[rebase]
	autoStash = true
[merge]
	conflictStyle = zdiff3
[rerere]
	autoupdate = false
[fetch]
	prune = true
[push]
	autoSetupRemote = true
